import { motion, AnimatePresence } from 'framer-motion'
import { FiLoader, FiCalendar, FiCheckCircle, FiMapPin, FiAward, FiExternalLink, FiTrendingUp, FiBriefcase, FiCode } from 'react-icons/fi'
import { useSanityMultiData } from '../hooks/useSanityData'
import { fetchProfile, fetchWorkExperience, fetchSkills, fetchCertificates, urlFor } from '../lib/sanity'
import { useState } from 'react'

const About = () => {
  const { data, loading, error } = useSanityMultiData([fetchProfile, fetchWorkExperience, fetchSkills, fetchCertificates])
  const [profileData, workExperience, skillsData, certificates] = data
  const [activeTab, setActiveTab] = useState('skills')

  const tabs = [
    { id: 'skills', label: 'Skills', icon: FiCode },
    { id: 'experience', label: 'Work Experience', icon: FiBriefcase },
    { id: 'certificates', label: 'Certificates', icon: FiAward },
  ]

  // Animation variants
  const containerVariants = {
    hidden: { opacity: 0 },
    visible: {
      opacity: 1,
      transition: {
        staggerChildren: 0.1
      }
    }
  }

  const itemVariants = {
    hidden: { y: 20, opacity: 0 },
    visible: {
      y: 0,
      opacity: 1,
      transition: {
        duration: 0.5,
        ease: 'easeOut'
      }
    }
  }

  // Loading state
  if (loading) {
    return (
      <section id="about" className="section">
        <div className="container-custom">
          <h2 className="section-title text-center">About Me</h2>
          <div className="flex justify-center items-center py-20">
            <FiLoader className="w-12 h-12 text-accent-magenta animate-spin" />
          </div>
        </div>
      </section>
    )
  }

  // Error state
  if (error) {
    return (
      <section id="about" className="section">
        <div className="container-custom">
          <h2 className="section-title text-center">About Me</h2>
          <div className="text-center py-20">
            <p className="text-text-muted">
              {error || 'Failed to load data. Please check your Sanity configuration.'}
            </p>
          </div>
        </div>
      </section>
    )
  }

  return (
    <section id="about" className="section">
      <div className="container-custom">
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          whileInView={{ opacity: 1, y: 0 }}
          viewport={{ once: true }}
          transition={{ duration: 0.6 }}
        >
          <h2 className="section-title text-center">About Me</h2>
          <p className="section-subtitle text-center mb-16">
            Get to know me better
          </p>
        </motion.div>

        {/* Profile Content */}
        {profileData && (
          <motion.div
            variants={containerVariants}
            initial="hidden"
            whileInView="visible"
            viewport={{ once: true }}
            className="grid grid-cols-1 lg:grid-cols-2 gap-12 mb-20"
          >
            {/* Profile Image & Info */}
            <motion.div variants={itemVariants} className="space-y-6">
              {profileData.image && (
                <div className="relative w-full max-w-md mx-auto lg:mx-0">
                  <div className="aspect-square rounded-2xl overflow-hidden border-4 border-accent-magenta/30">
                    <img
                      src={urlFor(profileData.image).width(600).height(600).url()}
                      alt={profileData.name}
                      className="w-full h-full object-cover"
                    />
                  </div>
                  <div className="absolute -z-10 top-8 left-8 w-full h-full rounded-2xl bg-accent-magenta/10" />
                </div>
              )}

              <div>
                <h3 className="text-3xl font-bold gradient-text mb-2">{profileData.name}</h3>
                <p className="text-xl text-accent-gold mb-4">{profileData.title}</p>
                
                {/* Contact Info */}
                <div className="space-y-2 text-text-muted">
                  {profileData.location && (
                    <div className="flex items-center gap-2">
                      <FiMapPin className="w-4 h-4 text-accent-magenta" />
                      <span>{profileData.location}</span>
                    </div>
                  )}
                </div>
              </div>
            </motion.div>

            {/* Full Bio */}
            <motion.div variants={itemVariants} className="space-y-6">
              {profileData.bio && (
                <div className="prose prose-invert prose-lg max-w-none">
                  <PortableText value={profileData.bio} />
                </div>
              )}
            </motion.div>
          </motion.div>
        )}

        {/* Skills Section */}
        {skillsData && skillsData.length > 0 && (
          <motion.div
            variants={containerVariants}
            initial="hidden"
            whileInView="visible"
            viewport={{ once: true }}
            className="mb-20"
          >
            <motion.h3
              variants={itemVariants}
              className="text-2xl font-bold text-center mb-10"
            >
              Skills & Technologies
            </motion.h3>

            <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {skillsData.map((skillCategory) => (
                <motion.div
                  key={skillCategory._id}
                  variants={itemVariants}
                  className="bg-card-bg border border-text-secondary/20 rounded-xl p-6 hover:border-accent-magenta transition-colors duration-300"
                >
                  <h4 className="text-lg font-semibold text-accent-gold mb-4">
                    {skillCategory.category}
                  </h4>
                  <div className="space-y-3">
                    {skillCategory.skills?.map((skill, skillIndex) => (
                      <div key={skillIndex} className="flex items-center justify-between">
                        <div className="flex items-center gap-3">
                          {skill.icon && (
                            <img
                              src={urlFor(skill.icon).width(24).height(24).url()}
                              alt={skill.name}
                              className="w-6 h-6"
                            />
                          )}
                          <span className="text-text-secondary">{skill.name}</span>
                        </div>
                        {skill.level && (
                          <span className={`text-xs px-2 py-1 rounded ${
                            skill.level === 'expert' ? 'bg-accent-magenta/20 text-accent-magenta' :
                            skill.level === 'advanced' ? 'bg-accent-gold/20 text-accent-gold' :
                            skill.level === 'intermediate' ? 'bg-blue-500/20 text-blue-400' :
                            'bg-text-secondary/20 text-text-muted'
                          }`}>
                            {skill.level}
                          </span>
                        )}
                      </div>
                    ))}
                  </div>
                </motion.div>
              ))}
            </div>
          </motion.div>
        )}

        {/* Work Experience Timeline */}
        {workExperience && workExperience.length > 0 && (
          <motion.div
            variants={containerVariants}
            initial="hidden"
            whileInView="visible"
            viewport={{ once: true }}
            className="mb-20"
          >
            <motion.h3
              variants={itemVariants}
              className="text-2xl font-bold text-center mb-10"
            >
              Work Experience
            </motion.h3>

            <div className="max-w-4xl mx-auto">
              {workExperience.map((exp, index) => (
                <WorkExperienceItem
                  key={exp._id}
                  experience={exp}
                  index={index}
                  itemVariants={itemVariants}
                />
              ))}
            </div>
          </motion.div>
        )}

        {/* Certificates Section */}
        {certificates && certificates.length > 0 && (
          <motion.div
            variants={containerVariants}
            initial="hidden"
            whileInView="visible"
            viewport={{ once: true }}
          >
            <motion.h3
              variants={itemVariants}
              className="text-2xl font-bold text-center mb-10"
            >
              Certifications & Achievements
            </motion.h3>

            <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {certificates.map((cert) => (
                <CertificateCard
                  key={cert._id}
                  certificate={cert}
                  itemVariants={itemVariants}
                />
              ))}
            </div>
          </motion.div>
        )}
      </div>
    </section>
  )
}

const WorkExperienceItem = ({ experience, itemVariants }) => {
  const formatDate = (dateString) => {
    if (!dateString) return ''
    const date = new Date(dateString)
    return date.toLocaleDateString('en-US', { year: 'numeric', month: 'short' })
  }

  return (
    <motion.div
      variants={itemVariants}
      className="relative pl-8 pb-12 last:pb-0"
    >
      {/* Timeline line */}
      <div className="absolute left-0 top-0 bottom-0 w-px bg-gradient-to-b from-accent-magenta via-accent-gold to-transparent" />

      {/* Timeline dot */}
      <div className="absolute left-0 top-2 w-3 h-3 -translate-x-[5.5px] rounded-full bg-accent-magenta border-4 border-deep-black" />

      {/* Content */}
      <div className="bg-card-bg border border-text-secondary/20 rounded-xl p-6 hover:border-accent-magenta transition-all duration-300 hover:shadow-lg hover:shadow-accent-magenta/10">
        <div className="flex flex-wrap items-start justify-between gap-4 mb-4">
          <div>
            <h4 className="text-xl font-bold text-text-primary mb-1">
              {experience.role}
            </h4>
            <p className="text-accent-gold font-medium">{experience.company}</p>
            {experience.location && (
              <div className="flex items-center gap-2 text-text-muted text-sm mt-1">
                <FiMapPin className="w-3 h-3" />
                <span>{experience.location}</span>
              </div>
            )}
          </div>
          {experience.isCurrent && (
            <span className="px-3 py-1 bg-accent-gold/20 text-accent-gold text-sm font-semibold rounded-full border border-accent-gold/30">
              Current
            </span>
          )}
        </div>

        {/* Date Range */}
        <div className="flex items-center gap-2 text-text-muted text-sm mb-4">
          <FiCalendar className="w-4 h-4" />
          <span>
            {formatDate(experience.startDate)} - {' '}
            {experience.isCurrent ? 'Present' : formatDate(experience.endDate)}
          </span>
        </div>

        {/* Description */}
        {experience.description && (
          <p className="text-text-muted mb-4">{experience.description}</p>
        )}

        {/* Responsibilities */}
        {experience.responsibilities && experience.responsibilities.length > 0 && (
          <div className="mb-4">
            <h5 className="text-sm font-semibold text-text-secondary mb-2">Key Responsibilities:</h5>
            <ul className="space-y-2">
              {experience.responsibilities.map((responsibility, idx) => (
                <li key={idx} className="flex items-start gap-2 text-text-muted">
                  <FiCheckCircle className="w-4 h-4 text-accent-magenta mt-1 flex-shrink-0" />
                  <span className="text-sm">{responsibility}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        {/* Achievements */}
        {experience.achievements && experience.achievements.length > 0 && (
          <div className="mb-4">
            <h5 className="text-sm font-semibold text-text-secondary mb-2">Key Achievements:</h5>
            <ul className="space-y-2">
              {experience.achievements.map((achievement, idx) => (
                <li key={idx} className="flex items-start gap-2 text-text-muted">
                  <FiTrendingUp className="w-4 h-4 text-accent-gold mt-1 flex-shrink-0" />
                  <span className="text-sm">{achievement}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        {/* Technologies */}
        {experience.technologies && experience.technologies.length > 0 && (
          <div className="flex flex-wrap gap-2 mt-4">
            {experience.technologies.map((tech, idx) => (
              <span
                key={idx}
                className="px-3 py-1 bg-card-bg-hover text-text-secondary text-xs rounded-lg border border-text-secondary/20"
              >
                {tech}
              </span>
            ))}
          </div>
        )}
      </div>
    </motion.div>
  )
}

const CertificateCard = ({ certificate, itemVariants }) => {
  const formatDate = (dateString) => {
    if (!dateString) return ''
    const date = new Date(dateString)
    return date.toLocaleDateString('en-US', { year: 'numeric', month: 'short' })
  }

  const isExpired = certificate.expiryDate && new Date(certificate.expiryDate) < new Date()

  return (
    <motion.div
      variants={itemVariants}
      className="bg-card-bg border border-text-secondary/20 rounded-xl overflow-hidden hover:border-accent-magenta transition-all duration-300 hover:shadow-lg hover:shadow-accent-magenta/10"
    >
      {certificate.image && (
        <div className="relative h-48 overflow-hidden">
          <img
            src={urlFor(certificate.image).width(400).height(300).url()}
            alt={certificate.title}
            className="w-full h-full object-cover"
          />
          {certificate.featured && (
            <div className="absolute top-2 right-2 bg-accent-gold text-deep-black px-2 py-1 rounded-full text-xs font-bold">
              ⭐ Featured
            </div>
          )}
        </div>
      )}
      
      <div className="p-6">
        <div className="flex items-start justify-between mb-2">
          <h4 className="text-lg font-bold text-text-primary">{certificate.title}</h4>
          <FiAward className="w-5 h-5 text-accent-magenta flex-shrink-0" />
        </div>
        
        <p className="text-accent-gold font-medium mb-2">{certificate.issuer}</p>
        
        <div className="text-text-muted text-sm mb-3">
          <div className="flex items-center gap-2">
            <FiCalendar className="w-4 h-4" />
            <span>
              {formatDate(certificate.issueDate)}
              {certificate.expiryDate && ` - ${formatDate(certificate.expiryDate)}`}
            </span>
          </div>
          {isExpired && (
            <span className="text-red-400 text-xs mt-1 inline-block">Expired</span>
          )}
        </div>

        {certificate.description && (
          <p className="text-text-muted text-sm mb-4">{certificate.description}</p>
        )}

        {certificate.skills && certificate.skills.length > 0 && (
          <div className="flex flex-wrap gap-2 mb-4">
            {certificate.skills.map((skill, idx) => (
              <span
                key={idx}
                className="px-2 py-1 bg-card-bg-hover text-text-secondary text-xs rounded border border-text-secondary/20"
              >
                {skill}
              </span>
            ))}
          </div>
        )}

        {certificate.credentialUrl && (
          <a
            href={certificate.credentialUrl}
            target="_blank"
            rel="noopener noreferrer"
            className="inline-flex items-center gap-2 text-accent-magenta hover:text-accent-magenta-hover text-sm transition-colors"
          >
            <span>View Credential</span>
            <FiExternalLink className="w-4 h-4" />
          </a>
        )}

        {certificate.credentialId && (
          <p className="text-text-muted text-xs mt-2">
            ID: {certificate.credentialId}
          </p>
        )}
      </div>
    </motion.div>
  )
}

export default About
